# ============================================================================
# Deny-first. Only source, docs, and the released artifacts are tracked.
# ============================================================================

# ---- Documents and archives ------------------------------------------------
*.pdf
*.mhtml
*.zip
*.tar
*.tar.gz

# ---- Working files kept outside the release --------------------------------
_private/
_working/
notes/

# ---- Raw results and activation caches: not part of this release -----------
results/
artifacts/
repro_*/
repro_smoke_*/
*.log
*.jsonl
per_sample*
activations_*

# ---- Model weights and benchmark data: never redistributed -----------------
/data/
/datasets/
checkpoints/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.arrow
*.parquet
# Fitted centroid banks are the one binary artifact we ship, and only from
# centroids/. A stray .npz elsewhere is almost certainly raw activations.
*.npz

# ---- Imagery ---------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.tif
*.tiff

# ---- LaTeX -----------------------------------------------------------------
*.tex
*.bbl
*.aux
*.synctex.gz

# ---- Standard Python -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# ---- Secrets ---------------------------------------------------------------
# Deliberately not the broad "*_token*" / "*_key*" globs: those match ordinary
# source files (visual_tokens.py) and would silently drop code from the release.
.env
.env.*
*.pem
*.key
*api_key*
*api_token*
*auth_token*
*access_token*
*credentials*
secrets.*
*.secret

# ============================================================================
# Explicit allows: the artifacts this release exists to ship.
# ============================================================================
!centroids/*.npz
!demo/fixtures/*.json
